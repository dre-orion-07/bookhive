generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String   @unique
  passwordHash    String?
  googleId        String?
  username        String   @unique
  displayName     String
  bio             String?
  avatar          String?
  location        String?
  website         String?
  favouriteGenres String[]
  favouriteAuthors String[]
  readingGoal     Int?
  isPrivateProfile Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Book {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  googleBooksId   String?
  openLibraryId   String?
  isbn10          String?
  isbn13          String?
  title           String
  subtitle        String?
  authors         String[]
  description     String?
  categories      String[]
  publisher       String?
  publishedDate   String?
  language        String?
  pageCount       Int?
  thumbnail       String?
  providerAverageRating Float?
providerRatingsCount  Int?
communityAverageRating Float?
communityRatingsCount  Int  @default(0)
  previewLink     String?
  infoLink        String?
  sourceProvider  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([title])
  @@index([authors])
  @@index([googleBooksId])
  @@index([isbn13])
}

model Library {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  bookId    String   @db.ObjectId
  addedAt   DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model ReadingProgress {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  bookId       String    @db.ObjectId
  status       String    @default("want_to_read")
  currentPage  Int?
  percentComplete Float  @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Bookshelf {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  name      String
  icon      String?
  bookIds   String[] @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  bookId    String   @db.ObjectId
  rating    Int
  title     String?
  content   String
  likedBy   String[] @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
}

model Recommendation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  bookId          String   @db.ObjectId
  reason          String?
  confidenceScore Float
  generatedBy     String
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([bookId])
}

model Follow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String   @db.ObjectId
  followingId String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}