generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String   @unique
  passwordHash    String?
  googleId        String?
  username        String   @unique
  displayName     String
  bio             String?
  avatar          String?
  location        String?
  website         String?
  favouriteGenres String[]
  favouriteAuthors String[]
  readingGoal     Int?
  isPrivateProfile Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Book {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  googleBooksId   String?
  openLibraryId   String?
  isbn10          String?
  isbn13          String?
  title           String
  subtitle        String?
  authors         String[]
  description     String?
  categories      String[]
  publisher       String?
  publishedDate   String?
  language        String?
  pageCount       Int?
  thumbnail       String?
  providerAverageRating Float?
providerRatingsCount  Int?
communityAverageRating Float?
communityRatingsCount  Int  @default(0)
  previewLink     String?
  infoLink        String?
  sourceProvider  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([title])
  @@index([authors])
  @@index([googleBooksId])
  @@index([isbn13])
}

model Library {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  bookId    String   @db.ObjectId
  addedAt   DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}

model ReadingProgress {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  bookId       String    @db.ObjectId
  status       String    @default("want_to_read")
  currentPage  Int?
  percentComplete Float  @default(0)
  startedAt    DateTime?
  finishedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([status])
}

model Bookshelf {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  name      String
  icon      String?
  bookIds   String[] @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  bookId    String   @db.ObjectId
  rating    Int
  title     String?
  content   String
  likedBy   String[] @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([bookId])
  @@index([userId])
}

model Recommendation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  bookId          String   @db.ObjectId
  reason          String?
  confidenceScore Float
  generatedBy     String
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([bookId])
}

model Follow {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  followerId  String   @db.ObjectId
  followingId String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model BookClub {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  coverImage  String?
  visibility  String   @default("public")
  ownerId     String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model ClubMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  clubId   String   @db.ObjectId
  userId   String   @db.ObjectId
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clubId      String   @db.ObjectId
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  videoRoomId String?
  createdAt   DateTime @default(now())

  @@index([clubId])
}

model ClubDiscussion {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clubId      String   @db.ObjectId
  authorId    String   @db.ObjectId
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clubId])
  @@index([authorId])
}

model ClubComment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  discussionId String   @db.ObjectId
  authorId     String   @db.ObjectId
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([discussionId])
  @@index([authorId])
}

enum ConversationType {
  PRIVATE
  GROUP
  CLUB
}

model Conversation {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  title          String?
  type           ConversationType
  clubId         String?  @db.ObjectId
  participantIds String[] @db.ObjectId
  lastMessageId  String?  @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([clubId])
}

model ConversationParticipant {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  userId         String   @db.ObjectId
  role           String   @default("member")
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  senderId       String   @db.ObjectId
  content        String
  attachments    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([conversationId])
  @@index([senderId])
}

model MessageRead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId  String   @db.ObjectId
  userId     String   @db.ObjectId
  readAt     DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageAttachment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId  String   @db.ObjectId
  url        String
  mimeType   String?
  createdAt  DateTime @default(now())

  @@index([messageId])
}